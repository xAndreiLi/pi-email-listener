# node_modules is a junction to the pi install for local development; it must never be packed.
node_modules/
*.log

# Mail and credentials must never reach the repository, not even by accident.
.mail/
**/*.eml
.env
.env.*

# jev-wiki runtime state; the decision ledger is committed as the audit trail
docs/wiki/.jev-wiki/*
!docs/wiki/.jev-wiki/decisions.jsonl
